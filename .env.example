# ---------------------------------------------------------------------------
# SubWatch runtime configuration. Copy to `.env` and adjust.
# `.env` is gitignored. Values shown are the built-in defaults.
# ---------------------------------------------------------------------------

# HTTP listener
PORT=8080
HOST=0.0.0.0

# Directory for SQLite DB, encryption key and backups. Must be persisted.
DATA_DIR=./data

# Default IANA timezone used for subscription dates and reminder scheduling.
TZ=Asia/Shanghai

# Optional: 32-byte key as 64 hex chars or base64. If absent, a key is
# generated once at DATA_DIR/.secret-key (mode 0600). BACK THIS UP.
# SUBWATCH_SECRET_KEY=

# Optional: bootstrap the admin password on first boot. Remove after setup.
# SUBWATCH_ADMIN_PASSWORD=

# Optional. Public URL used only for deep links in notifications. It is not
# needed to access SubWatch: http://<server-ip>:PORT works out of the box.
# When empty, SubWatch records the address used at first login automatically.
# SUBWATCH_BASE_URL=

# Set to 1 when running behind a trusted reverse proxy (Nginx/Caddy).
TRUST_PROXY=0

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Optional override for the built web UI directory (Docker sets this).
# SUBWATCH_WEB_DIR=
